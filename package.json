{
  "author": "Jens Oliver Meiert",
  "bin": {
    "html-minifier": "cli.js",
    "hm": "cli.js"
  },
  "bugs": "https://github.com/j9t/html-minifier/issues",
  "dependencies": {
    "acorn": "^8.19.0",
    "commander": "^15.1.0",
    "entities": "^9.0.0",
    "lightningcss": "^1.33.0",
    "svgo": "^4.1.0",
    "terser": "^5.51.4"
  },
  "description": "Highly effective, super-configurable, well-tested web page minifier",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.16.22",
    "@types/node": "^26.6.11",
    "alpinejs": "^3.17.5",
    "eslint": "^10.16.0",
    "globals": "^17.14.0",
    "parse5": "^8.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "exports": {
    ".": {
      "types": "./dist/types/htmlminifier.d.ts",
      "import": "./src/htmlminifier.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "cli.js",
    "dist/types",
    "html-minifier.schema.json",
    "src"
  ],
  "funding": "https://github.com/j9t/html-minifier?sponsor=1",
  "homepage": "https://htmlminifier.org/",
  "keywords": [
    "cli",
    "compress",
    "css",
    "html",
    "html-minifier",
    "htmlmin",
    "javascript",
    "llm",
    "minification",
    "minifier",
    "minify",
    "optimize",
    "performance",
    "sustainability",
    "svg",
    "svgo",
    "swc",
    "terser",
    "tokens",
    "uglify"
  ],
  "license": "MIT",
  "name": "html-minifier",
  "peerDependencies": {
    "@swc/core": "^1.15.7"
  },
  "peerDependenciesMeta": {
    "@swc/core": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/j9t/html-minifier.git"
  },
  "scripts": {
    "build": "tsc && npm run build:schema",
    "build:schema": "node scripts/build-schema.js",
    "build:site": "vite build && node cli.js --input-dir=site/build --output-dir=site/build --preset comprehensive --no-remove-attribute-quotes --no-remove-optional-tags",
    "deploy": "npm run build && npm run build:site",
    "lint": "eslint .",
    "prebuild": "node --input-type=module --eval \"import {rmSync} from 'fs';rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run build",
    "prepare": "git config core.hooksPath .githooks || true",
    "preview:site": "vite preview",
    "serve": "vite",
    "test": "npm run test:types && node --test \"test/**/*.test.js\" \"backtest/test/*.test.js\" && npm run test:site",
    "test:backtest": "node --test \"backtest/test/*.test.js\"",
    "test:equivalence": "node test/equivalence/corpus.js",
    "test:site": "node --test \"site/test/*.test.js\"",
    "test:types": "tsc --noEmit && tsc --project tsconfig.test.json",
    "test:watch": "node --test --watch \"test/**/*.test.js\" \"backtest/test/*.test.js\""
  },
  "type": "module",
  "types": "dist/types/htmlminifier.d.ts",
  "version": "5.4.2"
}